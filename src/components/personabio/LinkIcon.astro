---
const { url } = Astro.props;
let host = "";
try { host = new URL(url).hostname.replace(/^www\./, ""); } catch {}
const is = (domain: string) => host === domain || host.endsWith(`.${domain}`);
const kind = String(url).startsWith("mailto:") ? "email" : is("wa.me") || is("whatsapp.com") ? "whatsapp" : is("t.me") || is("telegram.me") ? "telegram" : is("reddit.com") ? "reddit" : is("github.com") ? "github" : is("soundcloud.com") ? "soundcloud" : is("instagram.com") ? "instagram" : is("facebook.com") ? "facebook" : is("medium.com") ? "medium" : is("pexels.com") ? "pexels" : is("substack.com") ? "substack" : is("x.com") || is("twitter.com") ? "x" : is("linkedin.com") ? "linkedin" : is("youtube.com") || is("youtu.be") ? "youtube" : "link";
---
<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor">
  {kind === "whatsapp" && <><path fill-rule="evenodd" d="M12 2a10 10 0 0 0-8.7 14.9L2 22l5.2-1.3A10 10 0 1 0 12 2Zm0 1.8a8.2 8.2 0 1 1-4.2 15.2l-.3-.2-3 .8.8-3-.2-.3A8.2 8.2 0 0 1 12 3.8Z"/><path d="M8.2 7.1c-.3 0-.6.1-.8.4-.5.5-.8 1.1-.8 1.9 0 1.2.9 2.7 2.3 4.1 1.5 1.5 3.4 2.4 4.8 2.6.9.1 1.9-.5 2.2-1.2.2-.4.2-.8.1-.9l-2-1c-.3-.1-.4-.1-.6.2l-.8 1c-.2.2-.4.2-.7.1-1.2-.5-2.5-1.6-3.1-2.8-.1-.3-.1-.4.1-.6l.6-.8c.1-.2.1-.4 0-.6l-.9-2.1c-.1-.3-.3-.3-.5-.3Z"/></>}
  {kind === "telegram" && <path d="m21.4 3.3-3.2 17c-.2 1.2-.9 1.5-1.9.9l-4.9-3.6-2.4 2.3c-.3.3-.5.5-1 .5l.4-5.1 9.3-8.4c.4-.4-.1-.6-.6-.2L5.6 13.9.7 12.4c-1.1-.3-1.1-1.1.2-1.6L20 3.4c.9-.3 1.6.2 1.4-.1Z"/>}
  {kind === "reddit" && <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="15" rx="8" ry="5.5"/><path d="m12 9.5 1.4-6 4.6 1M4.5 12a2.4 2.4 0 1 0-1.2 4M19.5 12a2.4 2.4 0 1 1 1.2 4M8.5 17c2 1.4 5 1.4 7 0"/><circle cx="19.5" cy="4.5" r="1.8"/><circle cx="8.5" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="15.5" cy="14" r="1" fill="currentColor" stroke="none"/></g>}
  {kind === "github" && <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.06c-3.1.68-3.76-1.31-3.76-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.59 1.2 3.22.92.1-.72.39-1.2.7-1.48-2.47-.28-5.07-1.23-5.07-5.49 0-1.21.43-2.2 1.14-2.97-.12-.28-.5-1.41.11-2.94 0 0 .93-.3 3.05 1.14a10.58 10.58 0 0 1 5.55 0c2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.71.77 1.14 1.76 1.14 2.97 0 4.27-2.6 5.21-5.08 5.49.4.35.75 1.02.75 2.06v3.02c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z" />}
  {kind === "instagram" && <g fill="none" stroke="currentColor" stroke-width="1.9"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.3"/><circle cx="17.7" cy="6.4" r=".7" fill="currentColor" stroke="none"/></g>}
  {kind === "facebook" && <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.95.93-1.95 1.88v2.26h3.32l-.53 3.49h-2.79V24C19.61 23.09 24 18.1 24 12.07Z"/>}
  {kind === "email" && <g fill="none" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"><rect x="1.5" y="4.5" width="21" height="15" rx=".6"/><path d="m2 5 10 9L22 5"/></g>}
  {kind === "soundcloud" && <><path d="M11 8a5 5 0 0 1 9 2.3A3.35 3.35 0 1 1 20.65 17H11Z"/>{[1,2.4,3.8,5.2,6.6,8,9.4].map((x,i)=><rect x={x} y={12-Math.min(i,5)*.72} width=".8" height={5+Math.min(i,5)*.72} rx=".4"/>)}</>}
  {kind === "medium" && <><ellipse cx="6.77" cy="12" rx="6.77" ry="6.82"/><ellipse cx="17.58" cy="12" rx="3.39" ry="6.42"/><ellipse cx="22.81" cy="12" rx="1.19" ry="5.75"/></>}
  {kind === "pexels" && <path d="M1.5 0A1.5 1.5 0 0 0 0 1.5v21A1.5 1.5 0 0 0 1.5 24h21a1.5 1.5 0 0 0 1.5-1.5v-21A1.5 1.5 0 0 0 22.5 0h-21Zm6.75 6.75h5.27a3.84 3.84 0 0 1 .63 7.63v2.87h-5.9V6.75Zm1.5 1.5v7.5h2.9v-2.81h.87a2.34 2.34 0 1 0 0-4.69H9.75Z" />}
  {kind === "substack" && <path d="M22.54 8.24H1.46V5.41h21.08v2.83Zm0-5.11H1.46V0h21.08v3.13ZM1.46 10.52h21.08V24L12 18.11 1.46 24V10.52Z" />}
  {kind === "x" && <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l8.2-9.5L.8 2h6.5l5.9 7.8L18.9 2Zm-1.1 18h1.7L6.4 4H4.6l13.2 16Z"/>}
  {kind === "linkedin" && <path d="M20.5 2h-17C2.7 2 2 2.7 2 3.5v17c0 .8.7 1.5 1.5 1.5h17c.8 0 1.5-.7 1.5-1.5v-17c0-.8-.7-1.5-1.5-1.5ZM8 19H5V9h3v10ZM6.5 7.7a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4ZM19 19h-3v-4.9c0-1.2 0-2.7-1.7-2.7s-2 1.3-2 2.6v5h-3V9h2.9v1.4h.1c.4-.8 1.4-1.7 2.9-1.7 3.1 0 3.8 2 3.8 4.5V19Z"/>}
  {kind === "youtube" && <><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8Z"/><path d="m9.6 15.6 6.2-3.6-6.2-3.6Z" fill="var(--personabio-social-icon-cutout)"/></>}
  {kind === "link" && <g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19 19 5M5 5h14v14"/></g>}
</svg>
