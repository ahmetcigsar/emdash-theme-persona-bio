---
import type { MenuItem } from "emdash";
import MenuItems from "./MenuItems.astro";
import { Image } from "emdash/ui";
import LinkIcon from "./LinkIcon.astro";
import FooterPreferences from "../FooterPreferences.astro";
import { localeFromUrl, translate } from "../../utils/i18n";
const locale = localeFromUrl(Astro.url);
interface Props {
  profile: {title: string; description?: string; avatar?: any};
  links: {label: string; url: string; target?: string}[];
  menu?: MenuItem[];
  edit?: Record<string, Record<string, string>>;
}
const { profile, links, menu = [], edit = {} } = Astro.props;
function profileLink(value: string) {
  const emailPath = value.match(/^\/email\/([^/?#\s]+@[^/?#\s]+)(\?.*)?$/i);
  if (emailPath) return `mailto:${emailPath[1]}${emailPath[2] ?? ""}`;
  return value;
}
function safeLink(value: string) {
  if (value.startsWith("/") && !value.startsWith("//")) return true;
  try { return ["https:", "http:", "mailto:", "tel:"].includes(new URL(value).protocol); } catch { return false; }
}
---
<div class="personabio-shell">
  <main class="personabio-card" id="main-content" aria-label={`${profile.title} ${translate(locale, "profili")}`}>
    <div class="personabio-profile">
      {profile.avatar && <div class="personabio-avatar" {...edit.avatar}><Image image={profile.avatar} alt={profile.avatar.alt || profile.title} width={168} height={168} priority /></div>}
      <h1 {...edit.title}>{profile.title}</h1>
      {profile.description && <p {...edit.description}>{profile.description}</p>}

    <nav class="personabio-links" aria-label={translate(locale, "Profil bağlantıları")}>
      <ul>{links.map(link => ({...link, href:profileLink(link.url)})).filter(link => safeLink(link.href)).map(link => <li><a href={link.href} aria-label={link.label} title={link.label} target={link.target} rel={link.target === "_blank" ? "noopener noreferrer" : undefined}><LinkIcon url={link.href}/></a></li>)}</ul>
    </nav>
    </div>
    <div class="personabio-secondary">
      {menu.length > 0 && <nav class="personabio-menu" aria-label={translate(locale, "Ana menü")}><MenuItems items={menu}/></nav>}
    </div>
  </main>
  <footer class="personabio-footer-container" aria-label={translate(locale, "Alt bilgi")}>
    <FooterPreferences />
  </footer>
</div>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const finePointer = window.matchMedia("(pointer: fine)");

  document.querySelectorAll<HTMLElement>(".personabio-card").forEach((card) => {
    let animationFrame = 0;

    card.addEventListener("pointermove", (event) => {
      if (reducedMotion.matches || !finePointer.matches) return;
      cancelAnimationFrame(animationFrame);
      animationFrame = requestAnimationFrame(() => {
        const bounds = card.getBoundingClientRect();
        card.style.setProperty("--glow-x", `${event.clientX - bounds.left}px`);
        card.style.setProperty("--glow-y", `${event.clientY - bounds.top}px`);
      });
    });

    card.addEventListener("pointerleave", () => {
      cancelAnimationFrame(animationFrame);
      card.style.setProperty("--glow-x", "50%");
      card.style.setProperty("--glow-y", "50%");
    });
  });
</script>
